SEMISURE_ENV=development
SEMISURE_CONFIG_DIR=configs
SEMISURE_HOST=127.0.0.1
SEMISURE_PORT=5000
SEMISURE_LOG_LEVEL=INFO
SEMISURE_DATA_DIR=data
SEMISURE_RUNTIME_DIR=runtime
SEMISURE_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
SEMISURE_MAX_CONTENT_LENGTH=2097152
SEMISURE_SOCKETIO_ASYNC_MODE=threading
SEMISURE_GUNICORN_THREADS=32
SEMISURE_GUNICORN_TIMEOUT=120

# Required secrets. Without these the platform refuses to construct its PUF,
# attestation and blockchain services, and readiness reports degraded with the
# missing subsystems named. Generate your own:
#
#   openssl rand -hex 32
#
# SEMISURE_PUF_MASTER_SECRET must be at least 32 characters. Enrolments derive
# from it and cannot be regenerated if it is lost, so keep it with your backups.
SEMISURE_PUF_MASTER_SECRET=
SEMISURE_OPENTITAN_VERIFICATION_KEY=

# Ethereum signer. Never commit a real key. The value below is Anvil's default
# development account: public, documented, and holding nothing on any real
# network. Replace it for anything other than a local chain.
SEMISURE_ETHEREUM_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
