                "confidence_score": 0.40,
            },
        )
    }


def build_compliance_payload(
    scan_id: str,
    simulation: dict[str, Any],
    *,
    anchor_to_blockchain: bool,
) -> dict[str, Any]:
    """Convert simulation fields into the compliance API contract."""
    compliance = simulation.get("compliance", {})

    if not isinstance(compliance, dict):
        compliance = {}

    supplier = simulation.get("supplier", {})

    if not isinstance(supplier, dict):
        supplier = {}

    scenario = str(simulation.get("scenario", "UNKNOWN"))

    item = {
        "subject_to_ear": compliance.get(
            "subject_to_ear",
            True,
        ),
        "eccn": compliance.get("eccn", ""),
        "usml_category": compliance.get("usml_category"),
        "specially_designed_for_military": compliance.get(
            "specially_designed_for_military",
            False,
        ),
        "defense_related": compliance.get(
            "defense_related",
            False,
        ),
        "tags": compliance.get(
            "tags",
            [scenario.lower()],
        ),
    }

    transaction = {
        "destination_country": compliance.get(
            "destination_country",
            "",
        ),
        "end_use": compliance.get("end_use", ""),
        "end_user_type": compliance.get(
            "end_user_type",
            "",
        ),
        "technical_data_transfer": compliance.get(
            "technical_data_transfer",
            False,
        ),
    }

    end_user_name = compliance.get(
        "end_user_name",
        f"{supplier.get('name', 'Unknown Supplier')} End User",
    )

    return {
        "scan_id": scan_id,
        "item": item,
        "transaction": transaction,
        "parties": {
            "end_user": {
                "name": end_user_name,
            }
        },
        "supplier": supplier,
        "ai": simulated_ai_result(simulation),
        "anchor_to_blockchain": anchor_to_blockchain,
    }


def scenario_should_anchor(simulation: dict[str, Any]) -> bool:
    """Anchor only simulations expected to reach verified provenance."""
    expected = simulation.get("expected_results", {})

    if not isinstance(expected, dict):
        return False

    blockchain = expected.get("blockchain_result", {})

    if not isinstance(blockchain, dict):
        return False

    fabric_result = str(blockchain.get("fabric", "")).upper()

    return fabric_result.startswith("COMMIT_")


def run_scan(
    simulation_path: Path,
    *,
    run_compliance: bool,
    anchor_override: bool | None,
) -> dict[str, Any]:
    """Submit one simulation through the currently available REST services."""
    simulation = load_json_file(simulation_path)
    application = create_app()

    with application.test_client() as client:
        submission = build_scan_submission(
            simulation_path,
            simulation,
        )

        scan_response = client.post(
            "/api/v1/scans",
            json=submission,
        )

        scan_payload = ensure_success(
            scan_response,
            f"scan submission for {simulation_path.name}",
        )

        scan_data = scan_payload["data"]
        scan_id = str(scan_data["scan_id"])

        result: dict[str, Any] = {
            "file": str(simulation_path),
            "scenario": simulation.get("scenario"),
            "scan": scan_data,
            "compliance": None,
        }

        if run_compliance:
            if anchor_override is None:
                anchor = scenario_should_anchor(simulation)
            else:
                anchor = anchor_override

            compliance_payload = build_compliance_payload(
                scan_id,
                simulation,
                anchor_to_blockchain=anchor,
            )

            compliance_response = client.post(
                "/api/v1/compliance/evaluate",
                json=compliance_payload,
            )

            result["compliance"] = ensure_success(
                compliance_response,
                f"compliance evaluation for {simulation_path.name}",
            )["data"]

        return result


def command_scan(args: argparse.Namespace) -> int:
    """Execute one JSON chip simulation."""
    result = run_scan(
        Path(args.file).expanduser().resolve(),
        run_compliance=not args.no_compliance,
        anchor_override=args.anchor_override,
    )

    print_json(result)
    return 0


def command_scan_all(args: argparse.Namespace) -> int:
    """Execute all JSON simulations in a directory."""
    directory = Path(args.directory).expanduser().resolve()

    if not directory.exists() or not directory.is_dir():
        raise CommandFailure(
            f"Simulation directory does not exist: {directory}"
        )

    files = sorted(directory.glob("*.json"))

    if not files:
        raise CommandFailure(
            f"No JSON files were found in {directory}"
        )

    results: list[dict[str, Any]] = []
    failures: list[dict[str, Any]] = []

    for simulation_path in files:
        try:
            result = run_scan(
                simulation_path,
                run_compliance=not args.no_compliance,
                anchor_override=args.anchor_override,
            )

            results.append(
                {
                    "file": simulation_path.name,
                    "scan_id": result["scan"]["scan_id"],
                    "scenario": result["scenario"],
                    "decision": (
                        result["compliance"]["decision"]["decision"]
                        if result.get("compliance")
                        else None
                    ),
                    "blockchain_error": (
                        result["compliance"].get("blockchain_error")
                        if result.get("compliance")
                        else None
                    ),
                }
            )
        except Exception as exc:
            failures.append(
                {
                    "file": simulation_path.name,
                    "error_type": type(exc).__name__,
                    "message": str(exc),
                }
            )

            if args.stop_on_error:
                break

    summary = {
        "directory": str(directory),
        "processed": len(results),
        "failed": len(failures),
        "results": results,
        "failures": failures,
    }

    print_json(summary)
    return 1 if failures else 0


def optional_get(
    client: Any,
    path: str,
) -> dict[str, Any] | None:
    """GET an optional resource without treating 404 as fatal."""
    response = client.get(path)
    payload = response_json(response)

    if response.status_code == 404:
        return None

    if response.status_code >= 400:
        return {
            "available": False,
            "http_status": response.status_code,
            "response": payload,
        }

    return payload.get("data", payload)


def command_verify_scan(args: argparse.Namespace) -> int:
    """Verify scan snapshot, events, compliance, and blockchain state."""
    scan_id = args.scan_id
    application = create_app()

    with application.test_client() as client:
        scan = ensure_success(
            client.get(f"/api/v1/scans/{scan_id}"),
            f"scan verification for {scan_id}",
        )["data"]

        events = optional_get(
            client,
            f"/api/v1/scans/{scan_id}/events",
        )

        compliance = optional_get(
            client,
            f"/api/v1/compliance/scans/{scan_id}",
        )

        blockchain = optional_get(
            client,
            f"/api/v1/blockchain/provenance/{scan_id}",
        )

    result = {
        "scan_id": scan_id,
        "scan": scan,
        "events": events,
        "compliance": compliance,
        "blockchain": blockchain,
        "verification": {
            "scan_exists": True,
            "event_count": scan.get("event_count"),
            "last_event_hash": scan.get("last_event_hash"),
            "compliance_available": compliance is not None,
            "blockchain_available": blockchain is not None,
        },
    }

    print_json(result)
    return 0


def command_verify_event_store(
    args: argparse.Namespace,
) -> int:
    """Verify every JSON event chain."""
    application = create_app()
    store = application.extensions["semisecure.event_store"]
    report = store.verify_all()

    if hasattr(report, "to_json"):
        raw = report.to_json()

        try:
            print_json(json.loads(raw))
        except json.JSONDecodeError:
            print(raw)
    else:
        print_json(report)

    valid = bool(getattr(report, "valid", True))
    return 0 if valid else 1


def command_system_status(args: argparse.Namespace) -> int:
    """Print system, hardware, compliance, and blockchain status."""
    application = create_app()

    with application.test_client() as client:
        result = {
            "system": optional_get(
                client,
                "/api/v1/system/status",
            ),
            "liveness": response_json(
                client.get("/health/live")
            ),
            "readiness": response_json(
                client.get("/health/ready")
            ),
            "hardware": optional_get(
                client,
                "/api/v1/hardware/status",
            ),
            "compliance": optional_get(
                client,
                "/api/v1/compliance/status",
            ),
            "blockchain": optional_get(
                client,
                "/api/v1/blockchain/status",
            ),
        }

    print_json(result)
    return 0


def command_export_audit(args: argparse.Namespace) -> int:
    """Export a government-audit JSON file for a scan."""
    scan_id = args.scan_id

    source = (
        PROJECT_ROOT
        / "data"
        / "compliance"
        / "government_audit"
        / f"{scan_id}.json"
    )

    if not source.exists():
        raise CommandFailure(
            f"Government audit package does not exist for scan "
            f"{scan_id}: {source}"
        )

    if args.output:
        destination = Path(args.output).expanduser().resolve()
    else:
        destination = (
            PROJECT_ROOT
            / "reports"
            / "exported_audits"
            / f"{scan_id}-government-audit.json"
        )

    destination.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    shutil.copy2(source, destination)

    result = {
        "scan_id": scan_id,
        "source": str(source),
        "output": str(destination),
        "sha256": sha256_file(destination),
        "size_bytes": destination.stat().st_size,
    }

    print_json(result)
    return 0


def add_server_arguments(
    parser: argparse.ArgumentParser,
) -> None:
    """Add Flask server arguments."""
    parser.add_argument(
        "--env",
        dest="environment",
        default=None,
    )
    parser.add_argument("--host", default=None)
    parser.add_argument("--port", type=int, default=None)

    debug_group = parser.add_mutually_exclusive_group()
    debug_group.add_argument(
        "--debug",
        action="store_true",
    )
    debug_group.add_argument(
        "--no-debug",
        action="store_true",
    )

    parser.add_argument(
        "--verify-event-store",
        action="store_true",
        dest="legacy_verify_event_store",
        help="Legacy compatibility flag.",
    )


def build_parser() -> argparse.ArgumentParser:
    """Build the complete SemiSecure command-line interface."""
    parser = argparse.ArgumentParser(
        prog="semisecure",
        description=(
            "SemiSecure terminal-controlled semiconductor "
            "security platform"
        ),
    )

    add_server_arguments(parser)

    commands = parser.add_subparsers(
        dest="command",
        title="commands",
    )

    serve_parser = commands.add_parser(
        "serve",
        help="Start the Flask-SocketIO backend.",
    )

    add_server_arguments(serve_parser)

    scan_parser = commands.add_parser(
        "scan",
        help="Submit one production chip JSON simulation.",
    )

    scan_parser.add_argument("file")
    scan_parser.add_argument(
        "--no-compliance",
        action="store_true",
        help="Submit ingestion only.",
    )

    scan_anchor = scan_parser.add_mutually_exclusive_group()
    scan_anchor.add_argument(
        "--anchor",
        action="store_const",
        const=True,
        dest="anchor_override",
    )
    scan_anchor.add_argument(
        "--no-anchor",
        action="store_const",
        const=False,
        dest="anchor_override",
    )

    scan_parser.set_defaults(anchor_override=None)

    scan_all_parser = commands.add_parser(
        "scan-all",
        help="Submit every JSON simulation in a directory.",
    )

    scan_all_parser.add_argument("directory")
    scan_all_parser.add_argument(
        "--no-compliance",
        action="store_true",
    )
    scan_all_parser.add_argument(
        "--stop-on-error",
        action="store_true",
    )

    scan_all_anchor = (
        scan_all_parser.add_mutually_exclusive_group()
    )

    scan_all_anchor.add_argument(
        "--anchor",
        action="store_const",
        const=True,
        dest="anchor_override",
    )
    scan_all_anchor.add_argument(
        "--no-anchor",
        action="store_const",
        const=False,
        dest="anchor_override",
    )

    scan_all_parser.set_defaults(anchor_override=None)

    verify_scan_parser = commands.add_parser(
        "verify-scan",
        help="Verify a scan and its linked records.",
    )

    verify_scan_parser.add_argument("scan_id")

    commands.add_parser(
        "verify-event-store",
        help="Verify every JSON event hash chain.",
    )

    commands.add_parser(
        "system-status",
        help="Show system and service status.",
    )

    export_parser = commands.add_parser(
        "export-audit",
        help="Export a government-audit package.",
    )

    export_parser.add_argument("scan_id")
    export_parser.add_argument(
        "--output",
        default=None,
    )

    return parser


def run_server(args: argparse.Namespace) -> int:
    """Start the Flask-SocketIO application."""
    if getattr(args, "environment", None):
        os.environ["SEMISURE_ENV"] = args.environment

    application = create_app()

    if getattr(
        args,
        "legacy_verify_event_store",
        False,
    ):
        store = application.extensions[
            "semisecure.event_store"
        ]
        report = store.verify_all()
        print(report.to_json())
        return 0 if report.valid else 1

    host = args.host or application.config["HOST"]
    port = args.port or int(application.config["PORT"])

    if args.debug:
        debug = True
    elif args.no_debug:
        debug = False
    else:
        debug = bool(application.config["DEBUG"])

    socketio.run(
        application,
        host=host,
        port=port,
        debug=debug,
        use_reloader=debug,
        allow_unsafe_werkzeug=debug,
    )

    return 0


def main(argv: Sequence[str] | None = None) -> int:
    """Run a server or terminal command."""
    load_dotenv(
        PROJECT_ROOT / ".env",
        override=False,
    )

    parser = build_parser()
    args = parser.parse_args(argv)

    handlers = {
        "scan": command_scan,
        "scan-all": command_scan_all,
        "verify-scan": command_verify_scan,
        "verify-event-store": command_verify_event_store,
        "system-status": command_system_status,
        "export-audit": command_export_audit,
    }

    try:
        if args.command in handlers:
            return handlers[args.command](args)

        return run_server(args)

    except CommandFailure as exc:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": {
                        "code": "command_failed",
                        "message": str(exc),
                    },
                },
                indent=2,
            ),
            file=sys.stderr,
        )

        return 1

    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
