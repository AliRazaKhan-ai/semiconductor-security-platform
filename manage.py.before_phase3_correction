PROJECT_ROOT = Path(__file__).resolve().parent


class CommandFailure(RuntimeError):
    """Raised when a CLI operation cannot be completed safely."""


def print_json(value: Any) -> None:
    """Print deterministic, readable JSON to stdout."""
    print(json.dumps(value, indent=2, ensure_ascii=False, default=str))


def load_json_file(path: Path) -> dict[str, Any]:
    """Read and validate a JSON object from disk."""
    if not path.exists():
        raise CommandFailure(f"File does not exist: {path}")

    if not path.is_file():
        raise CommandFailure(f"Path is not a file: {path}")

    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise CommandFailure(
            f"Invalid JSON in {path}: line {exc.lineno}, column {exc.colno}"
        ) from exc

    if not isinstance(payload, dict):
        raise CommandFailure(f"JSON root must be an object: {path}")

    return payload


def sha256_file(path: Path) -> str:
    """Calculate the SHA-256 digest of a file."""
    digest = hashlib.sha256()

    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def response_json(response: Any) -> dict[str, Any]:
    """Convert a Flask test response into a JSON object."""
    payload = response.get_json(silent=True)

    if isinstance(payload, dict):
        return payload

    return {
        "ok": False,
        "error": {
            "code": "invalid_response",
            "message": response.get_data(as_text=True),
        },
    }


def ensure_success(response: Any, operation: str) -> dict[str, Any]:
    """Require a successful internal REST response."""
    payload = response_json(response)

    if response.status_code >= 400 or not payload.get("ok", False):
        raise CommandFailure(
            f"{operation} failed with HTTP {response.status_code}:\n"
            f"{json.dumps(payload, indent=2, default=str)}"
        )

    return payload


def build_scan_submission(
    simulation_path: Path,
    simulation: dict[str, Any],
) -> dict[str, Any]:
    """Convert a production chip simulation into the public scan schema."""
    chip_id = str(simulation.get("chip_id", "")).strip()

    if not chip_id:
        raise CommandFailure(
            f"Simulation is missing chip_id: {simulation_path}"
        )

    source = simulation.get("source")

    if not isinstance(source, dict):
        source = {
            "component": "terminal",
            "operator": os.getenv("USER", "unknown"),
        }

    return {
        "chip_id": chip_id,
        "chip_file": simulation_path.name,
        "source": source,
        "evidence": {
            "simulation_file": str(simulation_path.resolve()),
            "simulation_sha256": sha256_file(simulation_path),
            "scenario": simulation.get("scenario", "UNKNOWN"),
        },
        "metadata": {
            "simulation_type": simulation.get(
                "simulation_type",
                "production_terminal_chip_scan",
            ),
            "scenario": simulation.get("scenario"),
            "manufacturing": simulation.get("manufacturing", {}),
            "failure_reason": simulation.get("failure_reason"),
            "hardware_security": simulation.get(
                "hardware_security",
                {},
            ),
            "supply_chain": simulation.get("supply_chain", {}),
            "supplier": simulation.get("supplier", {}),
            "compliance": simulation.get("compliance", {}),
            "expected_results": simulation.get(
                "expected_results",
                {},
            ),
        },
    }


