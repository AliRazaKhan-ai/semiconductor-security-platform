{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semisecure.local/schemas/chips/puf_enrollment.schema.json",
  "title": "Signed PUF Enrollment Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "identity_hash",
    "config_fingerprint",
    "enrolled_at_utc",
    "templates",
    "profile_version",
    "profile_signature"
  ],
  "properties": {
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "identity_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "enrolled_at_utc": {"type": "string", "format": "date-time"},
    "profile_version": {"type": "string", "minLength": 1},
    "profile_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "templates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge",
          "sealed_reference_hex",
          "seal_tag_hex",
          "reliability_mask",
          "stable_bit_count",
          "minimum_reliability",
          "maximum_hamming_ratio",
          "reference_noise_vector",
          "noise_scale_vector",
          "response_commitment"
        ],
        "properties": {
          "challenge": {"type": "object"},
          "sealed_reference_hex": {"type": "string", "pattern": "^[a-f0-9]+$"},
          "seal_tag_hex": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reliability_mask": {"type": "string", "pattern": "^[01]+$"},
          "stable_bit_count": {"type": "integer", "minimum": 1},
          "minimum_reliability": {"type": "number", "minimum": 0.5, "maximum": 1.0},
          "maximum_hamming_ratio": {"type": "number", "minimum": 0.0, "maximum": 0.49},
          "reference_noise_vector": {"type": "array", "minItems": 4, "items": {"type": "number"}},
          "noise_scale_vector": {"type": "array", "minItems": 4, "items": {"type": "number", "exclusiveMinimum": 0}},
          "response_commitment": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
