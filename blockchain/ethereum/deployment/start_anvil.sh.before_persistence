#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
LOG_FILE="$PROJECT_ROOT/runtime/anvil.log"
PID_FILE="$PROJECT_ROOT/runtime/anvil.pid"

export PATH="$HOME/.foundry/bin:$PATH"

if ! command -v anvil >/dev/null 2>&1; then
    echo "ERROR: anvil is not installed or is not in PATH."
    exit 1
fi

if curl -fsS \
    -X POST \
    -H "Content-Type: application/json" \
    --data '{"jsonrpc":"2.0","method":"eth_chainId","params":[],"id":1}' \
    http://127.0.0.1:8545 >/dev/null 2>&1; then
    echo "Anvil is already running on port 8545."
    exit 0
fi

nohup anvil \
    --host 127.0.0.1 \
    --port 8545 \
    --chain-id 31337 \
    --mnemonic "test test test test test test test test test test test junk" \
    --block-time 1 \
    >"$LOG_FILE" 2>&1 &

echo "$!" > "$PID_FILE"

for attempt in $(seq 1 30); do
    if curl -fsS \
        -X POST \
        -H "Content-Type: application/json" \
        --data '{"jsonrpc":"2.0","method":"eth_chainId","params":[],"id":1}' \
        http://127.0.0.1:8545 >/dev/null 2>&1; then
        echo "Anvil started successfully."
        echo "PID: $(cat "$PID_FILE")"
        echo "Log: $LOG_FILE"
        exit 0
    fi

    sleep 1
done

echo "ERROR: Anvil did not become ready."
tail -50 "$LOG_FILE"
exit 1
